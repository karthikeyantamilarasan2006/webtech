# =====================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Project: Student Feedback and Course Evaluation System
# Duplicate this file as .env or use config/env.php on your hosting server
# =====================================================================

# Application Environment (local or production)
APP_ENV=local
APP_DEBUG=true

# Database Credentials (Local XAMPP defaults vs. InfinityFree / Production)
# Local XAMPP Defaults:
DB_HOST=localhost
DB_NAME=student_feedback_system
DB_USER=root
DB_PASS=

# Production Hosting (e.g., InfinityFree / cPanel) Example:
# DB_HOST=sql200.epizy.com
# DB_NAME=if0_38123456_student_feedback
# DB_USER=if0_38123456
# DB_PASS=YourHostingPasswordHere

# OpenAI API Key for Campus Assistant Chatbot (Optional)
# If left blank, the chatbot automatically operates in offline Academic Knowledge Engine mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

